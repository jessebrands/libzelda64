#ifndef ZELDA64_CONFIG_H
#define ZELDA64_CONFIG_H

#define ZELDA64_MAKE_VERSION(major, minor, patch)                             \
      ((((major) & 0x7FFF) << 16)                                             \
    |  (((minor) & 0xFF)   << 8)                                              \
    |   ((patch) & 0xFF))

#define ZELDA64_VERSION_STRING "@PROJECT_VERSION@"
#define ZELDA64_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ZELDA64_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ZELDA64_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ZELDA64_VERSION ZELDA64_MAKE_VERSION(ZELDA64_VERSION_MAJOR, ZELDA64_VERSION_MINOR, ZELDA64_VERSION_PATCH)

#cmakedefine ZELDA64_USE_LIBC

#endif //ZELDA64_CONFIG_H
